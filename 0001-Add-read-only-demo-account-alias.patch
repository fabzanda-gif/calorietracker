@@ -214,12 +277,23 @@ def get_current_user(
                 headers={"WWW-Authenticate": "Bearer"},
             )
 
-        metadata = user.get("user_metadata") or {}
+        metadata = dict(
+            user.get("user_metadata") or {}
+        )
+        authenticated_id = str(user_id)
+        effective_id, metadata, read_only = (
