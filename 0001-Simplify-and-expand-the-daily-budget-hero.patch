+  .budgetHeadlineMetric:nth-child(3) { border-left: 1px solid rgba(255,255,255,.13); }
+  .budgetHeadlineMetric .budgetAvailable { font-size: 2.55rem; }
+  .budgetCalmStatus { grid-column: 1 / -1; padding: 16px 0 0; border-left: 0; border-top: 1px solid rgba(255,255,255,.13); }
+  .budgetDetailsGrid { grid-template-columns: 1fr 1fr; }
+  .budgetDetailsGrid .budgetDetail,
+  .budgetDetailsGrid .budgetDetail:nth-child(3) { padding: 0 12px; border: 0; }
+  .budgetDetailsGrid .budgetDetail:nth-child(odd) { padding-left: 0; }
+  .budgetScaleLabels { gap: 10px; font-size: 11px; }
+
   .budgetHeader {
     display: flex;
     flex-direction: column;
