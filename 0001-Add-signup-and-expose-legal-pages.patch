@@ -118,6 +122,26 @@ export function AuthProvider({
         }
       },
 
+      async signUpWithPassword(
+        email: string,
+        password: string,
+      ) {
+        const { data, error } =
+          await supabase.auth.signUp({
+            email,
+            password,
+            options: {
+              emailRedirectTo: window.location.origin,
+            },
+          });
+
+        if (error) {
+          throw error;
+        }
+
+        return data.session == null;
+      },
+
