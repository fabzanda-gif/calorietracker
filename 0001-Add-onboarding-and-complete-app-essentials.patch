diff --git a/frontend/app/legal.module.css b/frontend/app/legal.module.css
new file mode 100644
index 0000000..a3bd688
--- /dev/null
+++ b/frontend/app/legal.module.css
@@ -0,0 +1,16 @@
+.page { min-height: 100vh; padding: 64px 24px; background: #faf8f3; color: #102846; }
+.header, .content, .footer { width: min(820px, 100%); margin: 0 auto; }
+.header { padding-bottom: 34px; border-bottom: 1px solid #dedbd4; }
+.brand { display: inline-block; margin-bottom: 54px; color: #102846; font-size: 1.15rem; font-weight: 900; letter-spacing: .08em; text-decoration: none; }
+.kicker { margin: 0 0 10px; color: #ff6865; font-size: .72rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
+.header h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 4.8rem); line-height: .98; letter-spacing: -.055em; }
+.lead { max-width: 650px; margin: 22px 0 0; color: #596879; font-size: 1.15rem; line-height: 1.55; }
+.updated { margin: 24px 0 0; color: #7a8490; font-size: .82rem; }
+.content { padding: 18px 0 44px; }
+.content section { padding: 26px 0; border-bottom: 1px solid #e4e0d9; }
+.content h2 { margin: 0 0 10px; font-size: 1.14rem; }
+.content p { margin: 0; color: #4f5f70; line-height: 1.75; }
+.content a, .footer a { color: #d94d4a; font-weight: 750; }
+.content .notice { margin: 20px 0; padding: 24px; border: 1px solid #f4b7b2; border-radius: 18px; background: #fff0ee; }
+.footer { display: flex; justify-content: space-between; gap: 18px; padding-top: 24px; }
+@media (max-width: 600px) { .page { padding: 34px 20px; } .brand { margin-bottom: 38px; } .footer { flex-direction: column; } }
