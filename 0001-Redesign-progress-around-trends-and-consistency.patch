+/* SANOSYNC PROGRESS STORY V3 */
+.hero {
+  grid-template-columns: minmax(180px, .55fr) minmax(360px, 1.25fr) minmax(250px, .62fr);
+  align-items: center;
+  gap: 26px;
+  background: #102f50;
+}
+
+.heroSummary { min-width: 0; }
+.hero .changeDown,
+.hero .changeUp,
+.hero .changeNeutral {
+  display: inline-flex;
+  padding: 7px 11px;
+  border-radius: 999px;
+  background: rgba(89, 190, 112, .22);
+  color: #dff6e4;
+}
+
+.directionNote {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-top: 18px;
+  color: #fff;
+}
+.directionNote > span {
+  display: grid;
+  place-items: center;
+  width: 34px;
+  height: 34px;
+  border: 1px solid rgba(255, 102, 102, .72);
+  border-radius: 50%;
+  color: #ff7373;
+}
+.directionNote div { display: grid; gap: 2px; }
+.directionNote strong { font-size: .78rem; }
+.directionNote small { color: rgba(255,255,255,.62); font-size: .67rem; }
+
+.heroChartWrap { min-width: 0; color: #fff; }
+.heroChartWrap svg { display: block; width: 100%; height: 150px; overflow: visible; }
+.heroChartTitle { display: flex; justify-content: space-between; gap: 15px; font-size: .74rem; }
+.heroChartTitle span { color: rgba(255,255,255,.72); }
+.heroChartTitle strong { color: #fff; }
+.heroGridLine { stroke: rgba(255,255,255,.13); stroke-width: 1; stroke-dasharray: 3 5; }
+.heroTrendLine { stroke: #ff6868; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
+.heroTrendPoint { fill: #ff6868; stroke: #fff; stroke-width: 2; }
+.heroChartDates { display: flex; justify-content: space-between; color: rgba(255,255,255,.55); font-size: .65rem; }
+.heroChartEmpty { display: grid; place-items: center; min-height: 150px; color: rgba(255,255,255,.66); text-align: center; }
+
+.topStatsGrid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: 14px;
+}
+.topStatsGrid article {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+  padding: 15px 17px;
+  border: 1px solid #e2e5e4;
+  border-radius: 16px;
+  background: #fff;
+  box-shadow: 0 7px 20px rgba(16, 40, 70, .035);
+}
+.topStatsGrid article div { display: grid; gap: 3px; min-width: 0; }
+.topStatsGrid strong { color: #102846; font-size: 1.18rem; }
+.topStatsGrid article div > span { overflow: hidden; color: #718093; font-size: .69rem; text-overflow: ellipsis; white-space: nowrap; }
+.statIcon { display: grid; place-items: center; flex: 0 0 38px; width: 38px; height: 38px; border-radius: 50%; background: #eaf4eb; color: #448a51; font-weight: 900; }
+.statIconWarm { background: #fff3dc; color: #d89c25; }
+.statIconLilac { background: #f1edfb; color: #7863ae; }
+
+.overviewSection {
+  margin-top: 16px;
+  padding: 24px;
+  border: 1px solid #e2e5e4;
+  border-radius: 20px;
+  background: #fff;
+  box-shadow: 0 8px 24px rgba(16, 40, 70, .035);
+}
+.overviewSection .sectionHeader { align-items: start; }
+.overviewGrid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(270px, .7fr); gap: 24px; }
+.overviewChart { min-width: 0; padding-right: 22px; border-right: 1px solid #e7e9e8; }
+.insightPanel { min-width: 0; }
+.insightPanel h3 { margin: 0 0 18px; color: #102846; font-size: 1.3rem; letter-spacing: -.035em; }
+.insightPanel article { display: flex; gap: 11px; padding: 11px 0; border-bottom: 1px solid #edf0ef; }
+.insightPanel article > span { display: grid; place-items: center; flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: #eaf4eb; color: #448a51; font-weight: 900; }
+.insightPanel article:nth-of-type(2) > span { background: #f1edfb; color: #7863ae; }
+.insightPanel article:nth-of-type(3) > span { background: #fff3dc; color: #d89c25; }
+.insightPanel article div { display: grid; gap: 4px; }
+.insightPanel article strong { color: #153354; font-size: .8rem; line-height: 1.25; }
+.insightPanel article p { margin: 0; color: #718093; font-size: .69rem; line-height: 1.4; }
+.insightLink { display: flex; justify-content: center; margin-top: 17px; padding: 10px 14px; border: 1px solid #ff6868; border-radius: 999px; color: #ef5e5c; font-size: .72rem; font-weight: 800; }
+
+.analyticsSection { scroll-margin-top: 22px; }
+.consistencySection {
+  display: grid;
+  grid-template-columns: minmax(220px, .55fr) minmax(0, 1.45fr);
+  align-items: center;
+  gap: 24px;
+  margin-top: 18px;
+  padding: 22px 24px;
+  border: 1px solid #e2e5e4;
+  border-radius: 20px;
+  background: #fff;
+}
+.consistencySection h2 { margin: 0; color: #102846; font-size: 1.45rem; letter-spacing: -.04em; }
+.consistencyDays { display: grid; grid-template-columns: repeat(7, minmax(56px, 1fr)); gap: 9px; }
+.consistencyDays article { display: grid; justify-items: center; gap: 4px; color: #153354; }
+.consistencyDays strong { font-size: .69rem; text-transform: capitalize; }
+.consistencyDays small { color: #8490a0; font-size: .6rem; }
+.dayRing { display: grid; place-items: center; width: 45px; height: 45px; border: 4px solid #dfe4e2; border-radius: 50%; color: #87918d; font-weight: 900; }
+.dayRing_deficit { border-color: #55aa65; color: #448a51; }
+.dayRing_maintenance { border-color: #edbd4c; color: #c9941e; }
+.dayRing_surplus { border-color: #ff6868; color: #ef5e5c; }
+
+@media (max-width: 1050px) {
+  .hero { grid-template-columns: minmax(180px, .65fr) 1fr; }
+  .heroChartWrap { order: 3; grid-column: 1 / -1; }
+  .overviewGrid { grid-template-columns: 1fr; }
+  .overviewChart { padding-right: 0; border-right: 0; border-bottom: 1px solid #e7e9e8; padding-bottom: 18px; }
+}
+
+@media (max-width: 759px) {
+  .hero { grid-template-columns: 1fr; }
+  .heroChartWrap { grid-column: auto; }
+  .topStatsGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .overviewSection { padding: 17px; }
+  .consistencySection { grid-template-columns: 1fr; padding: 18px; }
+  .consistencyDays { overflow-x: auto; grid-template-columns: repeat(7, 70px); padding-bottom: 5px; }
+}
+
 
