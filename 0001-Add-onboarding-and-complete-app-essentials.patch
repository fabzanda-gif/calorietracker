+.backdrop {
+  position: fixed;
+  z-index: 1000;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  padding: 24px;
+  overflow-y: auto;
+  background: rgba(9, 30, 51, 0.72);
+  backdrop-filter: blur(12px);
+}
+
+.dialog {
+  width: min(680px, 100%);
+  padding: 34px;
+  border: 1px solid #f2c0ba;
+  border-radius: 30px;
+  background: #fffdf9;
+  color: #102846;
+  box-shadow: 0 30px 90px rgba(4, 24, 44, 0.3);
+}
+
+.progress { display: flex; gap: 7px; margin-bottom: 28px; }
+.progress span { width: 42px; height: 5px; border-radius: 9px; background: #e6e2dc; }
+.progress .progressActive { background: #ff6865; }
+.welcome { display: grid; justify-items: start; }
+.welcome img { width: 76px; height: 75px; object-fit: contain; margin-bottom: 18px; }
+.eyebrow { margin: 0 0 8px; color: #ff6865; font-size: 0.75rem; font-weight: 850; letter-spacing: 0.13em; text-transform: uppercase; }
+.dialog h1 { margin: 0; font-size: clamp(2rem, 6vw, 3.4rem); line-height: 0.98; letter-spacing: -0.05em; }
+.welcome > p:not(.eyebrow), .intro { max-width: 570px; margin: 18px 0 0; color: #657080; font-size: 1rem; line-height: 1.55; }
+.features { display: grid; gap: 10px; margin: 28px 0; font-weight: 700; }
+.features span { padding: 11px 14px; border-radius: 12px; background: #f7f3ed; }
+.dialog button { min-height: 48px; padding: 0 22px; border: 0; border-radius: 999px; background: #102846; color: white; font: inherit; font-weight: 800; cursor: pointer; }
+.dialog button:disabled { cursor: wait; opacity: 0.65; }
+.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 26px; }
+.grid label { display: grid; gap: 7px; color: #102846; font-size: 0.82rem; font-weight: 750; }
+.grid small { color: #7b8490; font-weight: 500; }
+.grid input, .grid select { min-width: 0; height: 48px; padding: 0 13px; border: 1px solid #dcd9d2; border-radius: 12px; background: white; color: #102846; font: inherit; }
+.grid input:focus, .grid select:focus { outline: 3px solid rgba(255, 104, 101, 0.18); border-color: #ff6865; }
+.fullWidth { grid-column: 1 / -1; }
+.actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
+.actions .back { background: transparent; color: #102846; border: 1px solid #dcd9d2; }
+.error { margin: 16px 0 0; padding: 12px; border-radius: 12px; background: #fff0ef; color: #a52d2a; }
+.consent { margin: 14px 0 0; color: #7b8490; text-align: right; font-size: 0.72rem; }
+
+@media (max-width: 600px) {
+  .backdrop { align-items: start; padding: 12px; }
+  .dialog { padding: 24px 20px; border-radius: 24px; }
+  .grid { grid-template-columns: 1fr; }
+  .fullWidth { grid-column: auto; }
+  .actions { display: grid; grid-template-columns: 1fr; }
+  .actions button[type="submit"] { order: -1; }
+  .consent { text-align: center; }
+}
