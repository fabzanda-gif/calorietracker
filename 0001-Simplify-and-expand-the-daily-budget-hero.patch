+.budgetSummary {
+  display: grid;
+  grid-template-columns: minmax(210px, 1.05fr) minmax(165px, .8fr) minmax(190px, .9fr) minmax(260px, 1.25fr);
+  align-items: center;
+  gap: 0;
+}
+
+.budgetQuestion,
+.budgetHeadlineMetric,
+.budgetCalmStatus {
+  min-width: 0;
+  padding: 4px 28px;
+}
+
+.budgetQuestion { padding-left: 0; }
+.budgetQuestion h2 {
+  max-width: 13ch;
+  margin: 0;
+  color: #f8fbff;
+  font-size: clamp(1.35rem, 2vw, 1.85rem);
+  line-height: 1.05;
+  letter-spacing: -.04em;
+}
+
+.budgetQuestion .budgetEyebrow {
+  margin: 0 0 9px;
+  color: rgba(248, 251, 255, .66);
+  font-size: .7rem;
+  letter-spacing: .11em;
+}
+
+.budgetHeadlineMetric,
+.budgetCalmStatus {
+  border-left: 1px solid rgba(255, 255, 255, .13);
+}
+
+.budgetHeadlineMetric .budgetAvailable {
+  font-size: clamp(3rem, 4.7vw, 4.5rem);
+}
+
+.budgetCalmStatus {
+  display: grid;
+  grid-template-columns: 34px 1fr;
+  column-gap: 12px;
+  align-items: start;
+}
+
+.budgetCalmStatus p {
+  margin: 0;
+  color: rgba(248, 251, 255, .9);
+  font-size: .9rem;
+  line-height: 1.42;
+}
+
+.budgetCalmIcon {
+  width: 30px;
+  height: 30px;
+  display: grid;
+  place-items: center;
+  border: 2px solid #55d879;
+  border-radius: 50%;
+  color: #55d879;
+  font-weight: 800;
+}
+
+.budgetToggle {
+  grid-column: 2;
+  position: relative;
+  width: fit-content;
+  margin-top: 10px;
+  padding: 0 23px 0 0;
+  border: 0;
+  background: transparent;
+  color: var(--ss-coral-500, #f47f7a);
+  font: inherit;
+  font-size: .82rem;
+  font-weight: 800;
+  cursor: pointer;
+}
+
+.budgetToggle:focus-visible {
+  outline: 2px solid #fff;
+  outline-offset: 5px;
+  border-radius: 4px;
+}
+
+.budgetToggle .budgetChevron {
+  right: 2px;
+  width: 8px;
+  height: 8px;
+  border-width: 0 2px 2px 0;
+}
+
+.budgetDetailsGrid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.budgetDetailsGrid .budgetDetail {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 4px;
+  padding: 0 28px;
+}
+
+.budgetDetailsGrid .budgetDetail:first-child { padding-left: 0; }
+.budgetDetailsGrid .budgetDetail:last-child { border-right: 0; }
+.budgetDetailsGrid .budgetDetail > span {
+  color: rgba(248, 251, 255, .72);
+  font-size: .84rem;
+}
+.budgetDetailsGrid .budgetDetail strong {
+  font-size: clamp(1.3rem, 2vw, 1.8rem);
+}
+.budgetDetailsGrid .budgetDetail small {
+  color: rgba(248, 251, 255, .58);
+  font-size: .72rem;
+}
+
+.budgetExpandedPanel .budgetScale { margin-top: 25px; }
+.budgetExpandedPanel .budgetExplanation {
+  margin: 20px 0 0;
+  padding: 14px 0 0;
+  border-top: 1px solid rgba(255, 255, 255, .1);
+}
+
+.budgetHeroCollapsed .budgetExpandedPanel { display: none; }
+
 .budgetHeader {
   display: grid;
 
